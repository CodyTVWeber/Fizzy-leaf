<main class="section" style="min-height:70vh;display:flex;align-items:center;justify-content:center;">
  <div class="container" style="text-align:center;max-width:420px;">
    <img src="{{ 'FizzyLeafLogo.webp' | asset_url }}" alt="Fizzy Leaf" style="height:120px;width:auto;margin:0 auto 1.5rem;">
    <h2>Coming soon</h2>
    <p class="lead" style="margin-left:auto;margin-right:auto;">Enter the store password to preview.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <p>
        <input type="password" name="password" placeholder="Password" style="width:100%;padding:0.85rem 1rem;border:1.5px solid var(--cream-dark);border-radius:12px;font-size:1rem;">
      </p>
      <button type="submit" class="btn btn-primary" style="width:100%;margin-top:0.75rem;">Enter</button>
    {% endform %}
  </div>
</main>
